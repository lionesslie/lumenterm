# ~/.config/lumenterm/lumenterm.toml örneği.
# Uygulama ilk açılışta bu dosyayı otomatik oluşturur; bu, referans için
# elle hazırlanmış bir örnektir. `notify` ile izlenir: kaydettiğiniz anda
# pencereyi kapatmadan uygulanır.

[font]
family = "JetBrains Mono"
size = 14.0
fallback = ["Noto Color Emoji", "Noto Sans CJK SC"]
antialiasing = "grayscale"

[theme]
name = "lumen-dark"
background = "#000000"
foreground = "#ffffff"
cursor = "#ffffff"
opacity = 0.98
palette = [
  "#15171e", "#f7768e", "#9ece6a", "#e0af68",
  "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5",
  "#414868", "#f7768e", "#9ece6a", "#e0af68",
  "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5",
]

[window]
padding = 8
corner_radius = 10.0
# Native pencere "top bar"ı (başlık çubuğu + kapat/küçült/büyüt
# düğmeleri). WM kullanıyorsanız (i3, sway, bspwm...) false bırakın --
# bu düğmelere ihtiyacınız olmaz. DE/DM kullanıyorsanız (GNOME, KDE,
# Windows masaüstü...) true yapın, kapatmak için düğmeye ihtiyacınız
# olur. Pencereyi kapatmadan değiştirip kaydedebilirsiniz, anında uygulanır.
decorations = false

[cursor]
style = "block"
blink = true
blink_interval_ms = 600
animation_ms = 90

[blocks]
enabled = true
fold_shortcut = "ctrl+shift+return"

[animations]
# Cursor'ın hücreden hücreye yumuşak kayması ve komut paletinin
# fade/slide-in açılışı gibi tüm "hareket" animasyonlarını tek
# yerden aç/kapat. false yapılınca bunlar anında (0ms) gerçekleşir.
# Cursor'ın yanıp sönmesi (yukarıdaki [cursor] blink) bundan etkilenmez.
enabled = true
